.venv/

# A0.3c: Legacy-Venv-Sicherung der Runtime-Migration liegt aus
# Atomaritaetsgruenden neben dem Pointer im selben Dateisystem. Ohne diesen
# Eintrag waere sie untracked und wuerde das exakt-clean-Gate des Boot-Guards
# dauerhaft brechen (Dienste starten dann auch nach Reboot nicht mehr).
.venv.a03c-legacy-*
build/
dist/
*.egg-info/

# local pytest basetemp (Windows workaround)
.pytest_tmp/

# local pytest basetemp (Windows workaround, session convention)
.audit_tmp/
